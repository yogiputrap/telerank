# =================================================================
# TeleRank Production Environment Variables (Dokploy / Coolify / VPS)
# =================================================================

# 1. Base URL & Domain (Contoh: https://telerank.id)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
APP_BASE_URL=https://yourdomain.com

# 2. Supabase Configuration (Database & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 3. PayKita Payment Gateway QRIS (pay.digikita.id)
PAYKITA_API_KEY=your-paykita-api-key
PAYKITA_WEBHOOK_SECRET=your-paykita-webhook-secret
PAYKITA_BASE_URL=https://pay.digikita.id

# 4. Telegram Bot API Integration (Auto-fetch bio & photo)
TELEGRAM_BOT_TOKEN=your-telegram-bot-father-token

# 5. Node / Container Environment
NODE_ENV=production
PORT=3000
