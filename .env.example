# Supabase server
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Supabase browser/public
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Legacy server key name (optional)
SUPABASE_SERVICE_ROLE_KEY=

# PayKita payment gateway (pay.digikita.id)
PAYKITA_API_KEY=
PAYKITA_WEBHOOK_SECRET=
PAYKITA_BASE_URL=https://pay.digikita.id

# Public base URL used to build the PayKita webhook callback (required in production)
APP_BASE_URL=https://yourdomain.com
